# Rust target directory
**/target/

# Python caches
__pycache__/
*.pyc

# azdo-manuals output: generated manuals name a real organization and are never committed
azdo-manuals/out/
azdo-manuals/**/*.utcp.json
!azdo-manuals/tests/fixtures/expected/*.utcp.json

# Local environment & secret files
**/.env
**/.env.*
!**/.env.example

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db

# UTCP local state/cache (if generated inside workspace during tests)
**/.utcp/
**/*.utcp.tmp
