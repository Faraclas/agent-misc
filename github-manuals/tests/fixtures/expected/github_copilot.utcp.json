{
  "manual_version": "1.0.0",
  "utcp_version": "1.0.0",
  "info": {
    "title": "GitHub Copilot",
    "version": "2026-03-10",
    "description": "GitHub Copilot (GitHub REST API 2026-03-10). Generated by github-manuals from GitHub's OpenAPI description (commit 000000000000). Authenticates with the token in GITHUB_MANUALS_PAT."
  },
  "tools": [
    {
      "name": "list_agent_tasks_for_repo",
      "description": "List tasks for repository",
      "tags": [
        "github",
        "agent-tasks"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "The account owner of the repository."
          },
          "repo": {
            "type": "string",
            "description": "The name of the repository."
          },
          "creator_id": {
            "type": "integer",
            "description": "Filter by creator. (one value)"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "Tasks retrieved successfully"
      },
      "tool_call_template": {
        "call_template_type": "http",
        "http_method": "GET",
        "url": "https://api.github.com/agents/repos/{owner}/{repo}/tasks",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10"
        },
        "auth": {
          "auth_type": "api_key",
          "var_name": "Authorization",
          "api_key": "Bearer ${GITHUB_MANUALS_PAT}",
          "location": "header"
        }
      }
    }
  ]
}
