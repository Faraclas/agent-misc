{
  "manual_version": "1.0.0",
  "utcp_version": "1.0.0",
  "info": {
    "title": "GitHub Actions, checks, deployments, packages and Pages",
    "version": "2026-03-10",
    "description": "GitHub Actions, checks, deployments, packages and Pages (GitHub REST API 2026-03-10). Generated by github-manuals from GitHub's OpenAPI description (commit 000000000000). Authenticates with the token in GITHUB_MANUALS_PAT."
  },
  "tools": [
    {
      "name": "create_check_run",
      "description": "(untested) Create a check run.",
      "tags": [
        "github",
        "checks",
        "runs",
        "untested"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "The account owner of the repository."
          },
          "repo": {
            "type": "string",
            "description": "The name of the repository."
          },
          "name": {
            "type": "string",
            "description": "The name of the check. For example, \"code-coverage\"."
          },
          "head_sha": {
            "type": "string",
            "description": "The SHA of the commit."
          }
        },
        "required": [
          "owner",
          "repo",
          "name",
          "head_sha"
        ]
      },
      "outputs": {
        "type": "object"
      },
      "tool_call_template": {
        "call_template_type": "http",
        "http_method": "POST",
        "url": "https://api.github.com/repos/{owner}/{repo}/check-runs",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10"
        },
        "auth": {
          "auth_type": "api_key",
          "var_name": "Authorization",
          "api_key": "Bearer ${GITHUB_MANUALS_PAT}",
          "location": "header"
        }
      }
    },
    {
      "name": "download_job_logs_for_workflow_run",
      "description": "Download job logs for a workflow run.",
      "tags": [
        "github",
        "actions",
        "workflow-jobs"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "The account owner of the repository."
          },
          "repo": {
            "type": "string",
            "description": "The name of the repository."
          },
          "job_id": {
            "type": "integer",
            "description": "The unique identifier of the job."
          }
        },
        "required": [
          "owner",
          "repo",
          "job_id"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "A file. utcp saves it (to the Downloads folder, or the path given with --out) and prints {\"type\": \"file\", \"path\", \"mime_type\", \"bytes\", \"filename\"}."
      },
      "tool_call_template": {
        "call_template_type": "http",
        "http_method": "GET",
        "url": "https://api.github.com/repos/{owner}/{repo}/actions/jobs/{job_id}/logs",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10"
        },
        "response_type": "file",
        "auth": {
          "auth_type": "api_key",
          "var_name": "Authorization",
          "api_key": "Bearer ${GITHUB_MANUALS_PAT}",
          "location": "header"
        }
      }
    }
  ]
}
